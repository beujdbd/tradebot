# =====================================================================
#  CONFIGURATION DU BOT — remplis les lignes marquées (OBLIGATOIRE)
#  Ne partage JAMAIS ce fichier : il contient ta clé privée.
# =====================================================================

# --- (OBLIGATOIRE) Clé privée du wallet qui va trader -----------------
# Utilise un wallet DÉDIÉ au bot, avec seulement l'argent que tu es prêt à perdre.
# Phantom : Paramètres > Gérer les comptes > ton compte > Afficher la clé privée
PRIVATE_KEY=

# --- Wallet du trader à copier ------------------------------------------
TARGET_WALLET=89HbgWduLwoxcofWpmn1EiF9wEdpgkNDEyPjzZ72mkDi

# --- (OBLIGATOIRE) Montant en SOL dépensé à CHAQUE achat du trader -------
BUY_AMOUNT_SOL=0.05

# --- (FORTEMENT CONSEILLÉ) RPC Solana rapide -----------------------------
# Le RPC public marche mais il est lent et limité. Helius gratuit : https://dashboard.helius.dev
# Exemple : https://mainnet.helius-rpc.com/?api-key=TA_CLE
RPC_URL=https://api.mainnet-beta.solana.com
# Optionnel : laisse vide, il est déduit de RPC_URL automatiquement
WS_URL=

# --- (FORTEMENT CONSEILLÉ) Clé API Jupiter gratuite ----------------------
# A créer sur https://portal.jup.ag (gratuit). Sans clé, l'API gratuite peut être limitée.
JUPITER_API_KEY=

# --- Mode simulation ------------------------------------------------------
# true  = le bot montre ce qu'il ferait, SANS acheter (pour tester)
# false = le bot trade pour de vrai
DRY_RUN=true

# =====================================================================
#  RÉGLAGES AVANCÉS (les valeurs par défaut conviennent)
# =====================================================================

# Slippage max accepté en % (les memecoins bougent vite : 10-25 conseillé)
SLIPPAGE_PERCENT=15
# Slippage pour les ventes (plus haut = on est sûr de pouvoir sortir)
SELL_SLIPPAGE_PERCENT=20

# Frais de priorité MAX par transaction, en SOL (plus haut = plus rapide)
PRIORITY_FEE_SOL=0.0005

# SOL toujours gardé de côté pour payer les frais (le bot n'achète pas en dessous)
MIN_SOL_RESERVE=0.02

# Copier aussi les ventes du trader (même pourcentage) : true / false
COPY_SELLS=true

# Nombre max d'achats par token (si le trader achète 10 fois le même token)
# 0 = illimité (copie chaque achat)
MAX_BUYS_PER_TOKEN=0

# Ignorer les achats du trader plus petits que ce montant en SOL (0 = tout copier)
MIN_TRADER_BUY_SOL=0

# N'acheter que si le trade du trader date de moins de X secondes
MAX_TRADE_AGE_SEC=60

# Ne vendre que les tokens achetés par le bot (protège tes autres tokens)
ONLY_SELL_BOT_TOKENS=true

# Au redémarrage, copier les ventes que le trader a faites pendant que le bot était éteint
CATCH_UP_SELLS=true

# Récupérer les ~0.002 SOL bloqués dans chaque compte de token vidé
CLOSE_EMPTY_ACCOUNTS=true

# Si Jupiter ne trouve pas le token (tout juste lancé), passer par PumpPortal (~0.5% de frais)
PUMPPORTAL_FALLBACK=true

# Nombre de nouvelles tentatives si un trade échoue
MAX_RETRIES=2

# Tokens à ne jamais copier (adresses séparées par des virgules)
IGNORE_TOKENS=

# Vérification de secours toutes les X secondes (en plus du temps réel)
POLL_INTERVAL_SEC=2

# --- Notifications Telegram (optionnel) -----------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Plus de détails dans les logs
DEBUG=false
