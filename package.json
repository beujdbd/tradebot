{
  "name": "solana-copy-trader",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de copy-trading Solana : copie les achats et les ventes d'un wallet",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node --no-deprecation src/index.js",
