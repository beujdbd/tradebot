local function getPadAt(position)
	for index, part in ipairs(padParts) do
		local offset = position - part.Position
		if math.abs(offset.X) <= 7.5 and math.abs(offset.Z) <= 7.5 and offset.Y > -1 and offset.Y < 8 then
			return index
		end
	end
	return nil
end

